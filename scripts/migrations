#!/bin/bash

set -u

SCRIPT_NAME="${BASH_SOURCE[0]##*/}"

show_usage() {
  cat <<EOF
Usage:
  ${SCRIPT_NAME} <add|remove>
  ${SCRIPT_NAME} help|-h|--help

Description:
  Adds or removes migrations for all API projects in the src directory.

Examples:
  ${SCRIPT_NAME} add
  ${SCRIPT_NAME} remove
  ${SCRIPT_NAME} help
EOF
}

run_for_projects() {
  local summary_verb="$1"
  local failure_verb="$2"
  local runner="$3"
  local done_message="$4"
  local failed_projects=()

  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
  API_ROOT="${ROOT_DIR}/src"

  echo "${summary_verb} migrations for all API projects..."

  shopt -s nullglob
  for project_dir in "${API_ROOT}"/*.Api; do
    if [[ -d "${project_dir}" ]]; then
      project_name="$(basename "${project_dir}")"
      echo "${summary_verb} migration for project: ${project_name}"
      if ! (cd "${project_dir}" && "${runner}"); then
        echo "Failed to ${failure_verb} migration for project: ${project_name}" >&2
        failed_projects+=("${project_name}")
      fi
    fi
  done
  shopt -u nullglob

  if ((${#failed_projects[@]})); then
    echo "Completed with errors for: ${failed_projects[*]}" >&2
    exit 1
  fi

  echo "${done_message}"
}

run_add() {
  dotnet ef migrations add "Initialize"
}

run_remove() {
  dotnet ef migrations remove
}

case "${1:-}" in
  help|-h|--help)
    show_usage
    exit 0
    ;;
  add)
    run_for_projects "Adding" "add" run_add "All migrations added."
    ;;
  remove)
    run_for_projects "Removing" "remove" run_remove "All migrations removed."
    ;;
  *)
    show_usage >&2
    exit 1
    ;;
esac
