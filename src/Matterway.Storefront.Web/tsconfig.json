{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./app/assets/*"],
      "@components/*": ["./app/components/*"],
      "@composables/*": ["./app/composables/*"],
      "@layouts/*": ["./app/layouts/*"],
      "@middleware/*": ["./app/middleware/*"],
      "@pages/*": ["./app/pages/*"],
      "@plugins/*": ["./app/plugins/*"],
      "@stores/*": ["./app/stores/*"],
      "$api/*": ["./server/api/*"],
      "#models/*": ["./models/*"],
      "#services/*": ["./services/*"]
    }
  }
}
