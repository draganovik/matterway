@startuml HLD: Platform - Class Diagram
skinparam classAttributeIconSize 10
hide circle

class ArticleCode <<value object>> {
  +value: String
}

note right of ArticleCode
  Exactly 8 uppercase
  letters or digits
end note

class OrderId <<value object>> {
  +value: String
}

note right of OrderId
  Canonical form:
  19 lowercase hex chars
end note

package "Identity" {
  enum EIdentityRole {
    Customer
    Employee
  }

  enum PermissionLevel {
    Observer
    Operator
    Manager
  }

  class SystemUser {
    +id: UUID
    --
    +userName: String
    +email: String
    +passwordHash: String
    +securityStamp: String
    +created: DateTime
  }

  class IdentityRole {
    +id: UUID
    --
    +name: String
    +normalizedName: String
  }

  class IdentityUserRole {
    +userId: UUID
    +roleId: UUID
  }

  class IdentityUserClaim {
    +id: Numeric
    --
    +userId: UUID
    ..
    +claimType: String
    +claimValue: String
  }

  note left of IdentityUserClaim
    Permission claims use:
    claimType = "perm"
    claimValue = "<service>:<level>"
    where level in PermissionLevel
    one claim per service for employees
    missing service claim resolves to Observer
  end note

  SystemUser "1" -- "0..*" IdentityUserClaim
  SystemUser "1" -- "0..*" IdentityUserRole
  IdentityUserRole "0..*" -- "1" IdentityRole
}

package "Catalog" {
  class Discount {
    +code: String
    --
    +articleCode: ArticleCode
    ..
    +percentage: Numeric
    +validFrom: DateTime
    +validTo: DateTime?
  }

  class Article {
    +code: ArticleCode
    --
    +title: String
    +description: String
    +basePrice: Money
    +isAvailable: Boolean
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class ArticleDetailText {
    +articleCode: ArticleCode
    +detailSlug: String
    --
    +value: String
  }

  class ArticleDetailNumeric {
    +articleCode: ArticleCode
    +detailSlug: String
    --
    +value: Numeric
  }

  class Detail {
    +slug: String
    --
    +title: String
    +unit: String?
  }

  class ArticleImage {
    +id: UUID
    --
    +articleCode: ArticleCode
    ..
    +orderIndex: Numeric
    +imageUrl: String
    +imageAlt: String?
  }

  note right of ArticleImage
    ImageUrl stores the canonical object URL.
    Web apps derive their local image proxy path
    from the image id and stream bytes from MinIO.
  end note

  Discount "0..*" -- "1" Article : articleCode
  ArticleDetailText "0..*" -- "1" Article : articleCode
  ArticleDetailText "0..*" -- "1" Detail : detailSlug
  ArticleDetailNumeric "0..*" -- "1" Article : articleCode
  ArticleDetailNumeric "0..*" -- "1" Detail : detailSlug
  ArticleImage "0..*" -- "1" Article : articleCode
}

package "Customers" {
  class Address {
    +id: UUID
    --
    +customerId: UUID
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }

  class Customer {
    +id: UUID
    --
    +firstName: String
    +lastName: String
    +birthDate: DateOnly
    +defaultAddressId: UUID?
  }

  class CustomerArticle {
    +id: UUID
    +articleCode: ArticleCode
    --
    +customerId: UUID
    +orderId: OrderId?
    +articleName: String?
    +unitPrice: Money?
    +quantity: Numeric
  }

  class CustomerOrder {
    +orderId: OrderId
    --
    +customerId: UUID
    ..
    +placedAt: DateTime
  }

  note right of Customer
    Public registration creates the
    Identity user first, then the
    Customer row. If the Customer
    write fails, the Identity user
    is deleted as cleanup.
  end note

  CustomerOrder "0..*" -- "1" Customer : customerId
  Customer "1" -- "0..1" Address : customerId
  CustomerArticle "0..*" -- "1" Customer : customerId
  CustomerArticle "0..*" -- "0..1" CustomerOrder : orderId
}

package "Sales" {

  class OrderDeliveryInfo {
    +id: UUID
    --
    +orderId: OrderId
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }
  class Order {
    +id: OrderId
    --
    +customerId: UUID?
    ..
    +placedAt: DateTime
    +type: EOrderType
  }

  class OrderItem {
    +id: UUID
    --
    +orderId: OrderId
    ..
    +articleCode: ArticleCode
    +articleTitle: String
    +unitPrice: Money
    +quantity: Numeric
  }

  note left of Order
    Current checkout flow
    1) Storefront -> Storefront Server: POST /api/storefront/checkout
    2) Storefront Server -> Stripe: initialize payment intent
    3) Storefront Server -> Sales: POST /api/system/v1/orders (+ customer JWT + system key)
    4) Sales reserves or reuses a pending OrderId, then mirrors cart items in Customers
    5) Sales updates the pending Order with items, delivery info, and Processing status
    6) Storefront Server -> Stripe: attach metadata(order_id) + confirm payment intent
    7) Stripe webhook -> Storefront Server: POST /api/storefront/webhooks/stripe
       Storefront Server -> Sales system/payment registration
    Checkout delivery country is fixed to Serbia.
  end note

  enum EOrderType {
    Retail
    Ecommerce
  }

  enum EOrderStatusType {
    Processing
    Reserved
    Delivery
    Completed
    Cancelled
  }

  class OrderStatus {
    +id: Numeric
    --
    +orderId: OrderId
    ..
    +changedAt: DateTime
    +status: EOrderStatusType
    +note: String?
  }

  class Payment {
    +id: UUID
    --
    +orderId: OrderId
    ..
    +provider: String
    +amount: Money
    +status: EPaymentStatus
    +createdAt: DateTime
  }

  enum EPaymentStatus {
    Reserved
    Charged
    Failed
    Refunded
  }

  OrderItem "0..*" -- "1" Order : orderId
  OrderStatus "0..*" -- "1" Order : orderId
  OrderDeliveryInfo "0..1" -- "1" Order : orderId
  Payment "0..*" -- "1" Order : orderId
}

SystemUser "1" .left. "0..1" Customer

CustomerArticle "0..*" .up. "1" Article
CustomerOrder "0..1" .right. "1" Order : shared orderId
@enduml
