@startuml LLD: Web Auth - Universal Sequence Diagram
skinparam defaultFontSize 16
skinparam actorStyle hollow
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 120

actor "User" as User
participant "Web Page\n(Storefront or Dashboard)" as Page
participant "Nuxt Route Middleware\n(auth.global.ts)" as Middleware
participant "Auth Session Store\n(useAuthSessionStore)" as AuthStore
participant "Feature Registry\n(Dashboard)" as Registry
participant "API Client\n(useApiClient)" as ApiClient
box "Outbound Systems" #FFF7ED
participant "Identity API\n(/api/identity/public/v1/auth)" as IdentityApi #FDBA74
participant "Nuxt Server Proxy\n(/api/<service>/...)" as DomainApi #FDBA74
end box

note over Page, IdentityApi
Storefront variant:
- Required role: customer
- Auth base path: /api/identity/public/v1/auth
- Browser-triggered API calls use same-origin `/api/<service>/...` proxy routes.
- The Nuxt server forwards those requests to internal service URLs.
- Unauthenticated redirect: /login?next=...
- After auth restore, a customer-session hook syncs the remote cart once;
  cart and checkout also force a sync on entry.
- Guest cart is merged after successful login/register.
- Cart is cleared when storefront auth is lost.

Dashboard variant:
- Required role: employee
- Auth base path: /api/identity/public/v1/auth
- Browser-triggered API calls use same-origin `/api/<service>/...` proxy routes.
- The Nuxt server forwards those requests to internal service URLs.
- Unauthenticated redirect: /login
- Permission check via service + level (observer/operator/manager)
- Authenticated-but-unauthorized route access logs out and redirects to /login
end note

== Login (Getting the token) ==
User -> Page : 1.1 Open /login
activate Page
Page -> AuthStore : 1.2 initialize()
activate AuthStore
AuthStore --> Page : 1.3 return initialized session state
deactivate AuthStore

User -> Page : 1.4 Submit credentials
Page -> AuthStore : 1.5 login(email, password)
activate AuthStore
AuthStore -> IdentityApi : 1.6 POST /login
activate IdentityApi
alt Login succeeds and role matches app policy
  IdentityApi --> AuthStore : 1.6.1.1 HTTP 200 LoginResponse
  AuthStore -> AuthStore : 1.6.1.2 setSession + write refresh cookie + scheduleRefresh
  AuthStore --> Page : 1.6.1.3 return login success
  alt Dashboard
    Page -> Registry : 1.6.1.4 Resolve first permitted feature route
    activate Registry
    Registry --> Page : 1.6.1.5 return first authorized route
    deactivate Registry
    Page --> User : 1.6.1.6 Navigate to first authorized route
  else Storefront
    Page -> Page : 1.6.1.4 merge guest cart into remote cart
    Page --> User : 1.6.1.5 Navigate to next route (or "/")
  end
else Login fails
  IdentityApi --> AuthStore : 1.6.2.1 HTTP 401/403 error payload
  AuthStore --> Page : 1.6.2.2 return login error
  Page --> User : 1.6.2.3 Show login error
else Login succeeds but role mismatches app policy
  IdentityApi --> AuthStore : 1.6.3.1 HTTP 200 LoginResponse
  AuthStore -> AuthStore : 1.6.3.2 setSession + write refresh cookie + scheduleRefresh
  AuthStore -> AuthStore : 1.6.3.3 clearSession()
  AuthStore --> Page : 1.6.3.4 return role error
  Page --> User : 1.6.3.5 Show login error
end
deactivate IdentityApi
deactivate AuthStore
deactivate Page

== Refresh strategy ==
User -> Page : 2.1 Open route
activate Page
Page -> Middleware : 2.2 Route navigation
activate Middleware
Middleware -> AuthStore : 2.3 initialize()
activate AuthStore
alt Access token exists and is not expired
  AuthStore -> AuthStore : 2.3.1.1 scheduleRefresh(2/3 token lifetime)
  AuthStore --> Middleware : 2.3.1.2 return initialized (authenticated)
else Access token missing/expired and refresh cookie exists,\nand refresh succeeds
  AuthStore -> IdentityApi : 2.3.2.1 POST /api/identity/public/v1/auth/refresh {refreshToken}
  activate IdentityApi
  IdentityApi --> AuthStore : 2.3.2.2 HTTP 200 LoginResponse
  AuthStore -> AuthStore : 2.3.2.3 setSession + write refresh cookie + scheduleRefresh
  AuthStore --> Middleware : 2.3.2.4 return initialized (authenticated)
  deactivate IdentityApi
else Access token missing/expired and refresh cookie exists,\nand refresh returns wrong role or fails
  AuthStore -> IdentityApi : 2.3.3.1 POST /api/identity/public/v1/auth/refresh {refreshToken}
  activate IdentityApi
  alt HTTP 200 LoginResponse but role mismatches app policy
    IdentityApi --> AuthStore : 2.3.3.2 HTTP 200 LoginResponse
    AuthStore -> AuthStore : 2.3.3.3 setSession + write refresh cookie + scheduleRefresh
    AuthStore -> AuthStore : 2.3.3.4 clearSession()
  else HTTP 401/403 error or network failure
    IdentityApi --> AuthStore : 2.3.3.2 HTTP 401/403 error
    AuthStore -> AuthStore : 2.3.3.3 clearSession()
  end
  AuthStore --> Middleware : 2.3.3.5 return initialized (anonymous)
  deactivate IdentityApi
else No access token and no refresh cookie
  AuthStore --> Middleware : 2.3.4.1 return initialized (anonymous)
end
deactivate AuthStore

alt Not authenticated for protected route
  Middleware --> Page : 2.4.1.1 Redirect to login variant
else Authenticated but not authorized (Dashboard only)
  Middleware -> Registry : 2.4.2.1 Resolve feature + required permissions
  activate Registry
  Registry --> Middleware : 2.4.2.2 return feature metadata
  deactivate Registry
  Middleware -> AuthStore : 2.4.2.3 hasPermission(service, allowedLevels)
  activate AuthStore
  AuthStore --> Middleware : 2.4.2.4 return false
  Middleware -> AuthStore : 2.4.2.5 logout()
  AuthStore -> IdentityApi : 2.4.2.6 POST /api/identity/public/v1/auth/logout (best effort)
  activate IdentityApi
  IdentityApi --> AuthStore : 2.4.2.7 HTTP 200/401/network error ignored
  deactivate IdentityApi
  AuthStore -> AuthStore : 2.4.2.8 clearSession() + remove refresh cookie
  deactivate AuthStore
  Middleware --> Page : 2.4.2.9 Redirect to /login
else Authenticated and authorized
  alt Dashboard
    Middleware -> Registry : 2.4.3.1 Resolve feature + required permissions
    activate Registry
    Registry --> Middleware : 2.4.3.2 return feature metadata
    deactivate Registry
    Middleware -> AuthStore : 2.4.3.3 hasPermission(service, allowedLevels)
    activate AuthStore
    AuthStore --> Middleware : 2.4.3.4 return true
    deactivate AuthStore
    Middleware --> Page : 2.4.3.5 Continue navigation
  else Storefront
    Middleware --> Page : 2.4.3.1 Continue navigation
  end
end
deactivate Middleware
deactivate Page

User -> Page : 3.1 Trigger API action
activate Page
Page -> ApiClient : 3.2 request(service, path)
activate ApiClient
ApiClient -> AuthStore : 3.3 initialize() if needed
activate AuthStore
AuthStore --> ApiClient : 3.4 return auth ready
deactivate AuthStore

ApiClient -> DomainApi : 3.5 HTTP request to /api/<service>/... + Bearer token
activate DomainApi
alt Domain API returns 401 and refresh succeeds
  DomainApi --> ApiClient : 3.5.1.1 HTTP 401 Unauthorized
  ApiClient -> AuthStore : 3.5.1.2 refreshTokens()
  activate AuthStore
  AuthStore -> IdentityApi : 3.5.1.3 POST /api/identity/public/v1/auth/refresh
  activate IdentityApi
  IdentityApi --> AuthStore : 3.5.1.4 HTTP 200 LoginResponse
  deactivate IdentityApi
  AuthStore --> ApiClient : 3.5.1.5 return refreshed token state
  deactivate AuthStore
  ApiClient -> DomainApi : 3.5.1.6 Retry HTTP request to /api/<service>/... with new Bearer
  activate DomainApi
  DomainApi --> ApiClient : 3.5.1.7 HTTP retried response
  deactivate DomainApi
else Domain API returns 401 and refresh fails
  DomainApi --> ApiClient : 3.5.2.1 HTTP 401 Unauthorized
  deactivate DomainApi
  ApiClient -> AuthStore : 3.5.2.2 refreshTokens()
  activate AuthStore
  AuthStore -> IdentityApi : 3.5.2.3 POST /api/identity/public/v1/auth/refresh
  activate IdentityApi
  IdentityApi --> AuthStore : 3.5.2.4 HTTP 200 wrong-role response or 401/403 error
  AuthStore -> AuthStore : 3.5.2.5 clearSession()
  AuthStore --> ApiClient : 3.5.2.6 return refresh failure (no token)
  deactivate IdentityApi
  deactivate AuthStore
  ApiClient --> Page : 3.5.2.7 Return original 401 ApiResult (no retry)
else Domain API returns non-401
  DomainApi --> ApiClient : 3.5.3.1 HTTP response
  deactivate DomainApi
end

ApiClient --> Page : 3.6 return ApiResult
deactivate ApiClient
deactivate Page

== Logout ==
User -> Page : 4.1 Click logout
activate Page
Page -> AuthStore : 4.2 logout()
activate AuthStore
AuthStore -> IdentityApi : 4.3 POST /api/identity/public/v1/auth/logout (best effort)
activate IdentityApi
IdentityApi --> AuthStore : 4.4 HTTP 200/401/network error ignored
deactivate IdentityApi
AuthStore -> AuthStore : 4.5 clearSession() + remove refresh cookie
AuthStore --> Page : 4.6 return logout completed
deactivate AuthStore
Page -> Page : 4.7 clear cart on auth loss
Page --> User : 4.8 Navigate to app logout target
deactivate Page

@enduml
