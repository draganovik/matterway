@startuml LLD: Place Order - Sequence Diagram
skinparam defaultFontSize 16
skinparam actorStyle hollow
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 120

actor "Customer" as Customer

participant "Web Client\n(Storefront)" as Client
participant "Backend for Frontend\n(BFF)" as Bff

box "Application Services" #FFF7ED
participant "Sales Service" as Sales #FDBA74
participant "Customer Service" as Customers #FDBA74
end box
participant "Payment Provider" as Payment #9CAAF5

note over Client, Payment
Payment is prepared before the order is created, but confirmed only after
the Sales Service has created the canonical order from the customer's cart.
end note

== Place order ==
Customer -> Client : 1.1 Submit checkout details
activate Client
Client -> Client : 1.2 Validate checkout details

alt Validation fails
  Client --> Customer : 1.2.1.1 Show validation errors
else Validation succeeds
  Client -> Bff : 1.2.2.1 Place order
  activate Bff
  Bff -> Payment : 1.2.2.2 Prepare payment
  activate Payment

  alt Payment preparation fails
    Payment --> Bff : 1.2.2.2.1.1 Return payment failure
    deactivate Payment
    Bff --> Client : 1.2.2.2.1.2 Return checkout failure
    Client --> Customer : 1.2.2.2.1.3 Show payment error
  else Payment is prepared
    Payment --> Bff : 1.2.2.2.2.1 Return payment reference
    deactivate Payment
    note over Client, Payment
    The checkout remains in progress and continues with order creation.
    The prepared payment has not yet been confirmed.
    end note
  end
end

Bff -> Sales : 2.1 Create order
activate Sales
Sales -> Customers : 2.2 PUT order snapshot by order ID
activate Customers

alt Order creation succeeds
  Customers --> Sales : 2.2.1.1 Return finalized items and total
  deactivate Customers
  Sales -> Sales : 2.2.1.2 Create canonical order
  Sales --> Bff : 2.2.1.3 Return created order
  deactivate Sales
  Bff -> Payment : 2.2.1.4 Confirm payment for the order
  activate Payment
  Payment --> Bff : 2.2.1.5 Confirm payment
  deactivate Payment
  Bff --> Client : 2.2.1.6 Return completed order
  Client -> Client : 2.2.1.7 Clear local cart
  Client --> Customer : 2.2.1.8 Show placed orders
else Order creation fails
  Customers --> Sales : 2.2.2.1 Return finalization failure
  deactivate Customers
  Sales --> Bff : 2.2.2.2 Return order failure
  deactivate Sales
  Bff -> Payment : 2.2.2.3 Cancel prepared payment
  activate Payment
  Payment --> Bff : 2.2.2.4 Confirm cancellation
  deactivate Payment
  Bff --> Client : 2.2.2.5 Return checkout failure
  Client --> Customer : 2.2.2.6 Show checkout error
end
deactivate Bff
deactivate Client

newpage Asynchronous payment notification

== Asynchronous payment notification ==
Payment -> Bff : 3.1 Send payment event

activate Bff
Bff -> Bff : 3.2 Classify event

alt Successful charge for an order
  Bff -> Sales : 3.2.1.1 Record payment outcome
  activate Sales
  Sales -> Sales : 3.2.1.2 Verify order and store payment record
  Sales --> Bff : 3.2.1.3 Confirm payment recorded
  deactivate Sales
  Bff --> Payment : 3.2.1.4 Accept event
else Unrelated event
  Bff --> Payment : 3.2.2.1 Ignore event
  deactivate Bff
end

@enduml
