@startuml HLD: Platform - Class Diagram
skinparam defaultFontSize 28
skinparam Ranksep 50
hide circle

together {
  class ArticleCode <<value object>> {
    +value: String
  }
  note right of ArticleCode
    Exactly 8 uppercase
    letters or digits
  end note

  class OrderId <<value object>> {
    +value: String
  }

  note right of OrderId
    Canonical form:
    19 lowercase hex chars
  end note
}

package "Identity" {
  enum EIdentityRole {
    Customer
    Employee
  }

  enum PermissionLevel {
    Observer
    Operator
    Manager
  }

  class SystemUser {
    +id: UUID
    --
    +userName: String
    +email: String
    +passwordHash: String
    +securityStamp: String
    +created: DateTime
  }

  class IdentityRole {
    +id: UUID
    --
    +name: String
    +normalizedName: String
  }

  class IdentityUserRole {
    +userId: UUID
    +roleId: UUID
  }

  class IdentityUserClaim {
    +id: Numeric
    --
    +userId: UUID
    ..
    +claimType: String
    +claimValue: String
  }

  SystemUser "1" -- "0..*" IdentityUserClaim : userId
  SystemUser "1" -- "0..*" IdentityUserRole : userId
  IdentityUserRole "0..*" -- "1" IdentityRole : roleId
}

package "Catalog" {
  class Discount {
    +code: String
    --
    +articleCode: ArticleCode
    ..
    +percentage: Numeric
    +validFrom: DateTime
    +validTo: DateTime?
  }

  class Article {
    +code: ArticleCode
    --
    +title: String
    +description: String
    +basePrice: Money
    +isAvailable: Boolean
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class ArticleDetailText {
    +articleCode: ArticleCode
    +detailSlug: String
    --
    +value: String
  }

  class ArticleDetailNumeric {
    +articleCode: ArticleCode
    +detailSlug: String
    --
    +value: Numeric
  }

  class Detail {
    +slug: String
    --
    +title: String
    +unit: String?
  }

  class ArticleImage {
    +id: UUID
    --
    +articleCode: ArticleCode
    ..
    +orderIndex: Numeric
    +imageUrl: String
    +imageAlt: String?
  }

  Discount "0..*" -- "1" Article : articleCode
  ArticleDetailText "0..*" -- "1" Article : articleCode
  ArticleDetailText "0..*" -u- "1" Detail : detailSlug
  ArticleDetailNumeric "0..*" -- "1" Article : articleCode
  ArticleDetailNumeric "0..*" -u- "1" Detail : detailSlug
  ArticleImage "0..*" -- "1" Article : articleCode
}

package "Customers" {
  class Address {
    +id: UUID
    --
    +customerId: UUID
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }

  class Customer {
    +id: UUID
    --
    +firstName: String
    +lastName: String
    +birthDate: DateOnly
    +defaultAddressId: UUID?
  }

  class CustomerArticle {
    +id: UUID
    +articleCode: ArticleCode
    --
    +customerId: UUID
    +orderId: OrderId?
    +articleName: String
    +unitPrice: Money?
    +quantity: Numeric
  }

  class CustomerOrder {
    +orderId: OrderId
    --
    +customerId: UUID
    ..
    +placedAt: DateTime
  }

  CustomerOrder "0..*" -- "1" Customer : customerId
  Customer "1" -l- "0..1" Address : customerId \n
  CustomerArticle "0..*" -r- "1" Customer : customerId
  CustomerArticle "0..*" -r- "0..1" CustomerOrder : orderId \n
}

package "Sales" {

  class OrderDeliveryInfo {
    +id: UUID
    --
    +orderId: OrderId
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String?
    +contactPhone: String
  }

  class Order {
    +id: OrderId
    --
    +customerId: UUID?
    ..
    +placedAt: DateTime
    +type: EOrderType
  }

  class OrderItem {
    +id: UUID
    --
    +orderId: OrderId
    ..
    +articleCode: ArticleCode
    +articleTitle: String
    +unitPrice: Money
    +quantity: Numeric
  }

  class OrderStatus {
    +id: Numeric
    --
    +orderId: OrderId
    ..
    +changedAt: DateTime
    +status: EOrderStatusType
    +note: String?
  }

  class Payment {
    +id: UUID
    --
    +orderId: OrderId
    ..
    +provider: String
    +amount: Money
    +status: EPaymentStatus
    +createdAt: DateTime
  }

  enum EOrderStatusType {
    Processing
    Reserved
    Delivery
    Completed
    Cancelled
  }

  enum EPaymentStatus {
    Reserved
    Charged
    Failed
    Refunded
  }

  enum EOrderType {
    Retail
    Ecommerce
  }

  OrderItem "0..*" -- "1" Order : orderId
  OrderStatus "0..*" -u- "1" Order : orderId
  OrderDeliveryInfo "0..1" -r- "1" Order : orderId \n
  Payment "0..*" -d- "1" Order : orderId
}

Customer "0..1" .u. "1" SystemUser : ref.

CustomerArticle "0..*" .u. "1" Article : ref.

CustomerOrder "0..1" .. "1" Order : ref.

@enduml
