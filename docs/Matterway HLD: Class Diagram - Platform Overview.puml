@startuml HLD: Class Diagram - Platform Overview
skinparam classAttributeIconSize 10
hide circle

' =======================
' MODULES
' =======================

package "Identity" {
  enum EIdentityRole {
    Admin
    Manager
    Customer
  }

  class SystemUser {
    +id: UUID
    --
    +userName: String
    +email: String
    +passwordHash: String
    +securityStamp: String
    +created: DateTime
  }

  class IdentityRole {
    +id: UUID
    --
    +name: String
    +normalizedName: String
  }

  class IdentityUserRole {
    +userId: UUID
    +roleId: UUID
  }

  class IdentityUserClaim {
    +id: Integer
    --
    +userId: UUID
    ..
    +claimType: String
    +claimValue: String
  }

  SystemUser "1" -- "0..*" IdentityUserClaim
  SystemUser "1" -- "0..*" IdentityUserRole
  IdentityUserRole "0..*" -- "1" IdentityRole
}

package "Catalog" {
  class Discount {
    +code: String
    --
    +articleId: UUID
    ..
    +percentage: Decimal
    +validFrom: DateTime
    +validTo: DateTime?
  }

  class Article {
    +id: UUID
    --
    +articleCode: String
    +title: String
    +description: String
    +basePrice: Money
    +isAvailable: Boolean
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class ArticleDetail {
    +articleId: UUID
    +detailSlug: String
    --
    +value: String
  }

  class Detail {
    +slug: String
    --
    +title: String
  }

  class AttributeSlug {
    +slug: String
  }

  note top of AttributeSlug
  Shared, unique slug namespace
  for Detail & Specification
  (lowercase normalized)
  end note

  class ArticleSpecification {
    +articleId: UUID
    +specificationSlug: String
    --
    +value: Decimal
  }

  class Specification {
    +slug: String
    --
    +title: String
    +unit: String?
  }

  class ArticleImage {
    +id: UUID
    --
    +articleId: UUID
    ..
    +orderIndex: Integer
    +imageUrl: String
    +imageAlt: String?
  }

  Discount "0..*" -- "1" Article : articleId
  ArticleDetail "0..*" -- "1" Article : articleId
  ArticleDetail "0..*" -- "1" Detail : detailSlug
  ArticleSpecification "0..*" -- "1" Article : articleId
  ArticleSpecification "0..*" -- "1" Specification : specificationSlug
  ArticleImage "0..*" -- "1" Article : articleId
  Detail -- AttributeSlug : slug (PK/FK)
  Specification -- AttributeSlug : slug (PK/FK)
}

package "Customers" {
  class Address {
    +id: UUID
    --
    +customerId: UUID
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }

  class Customer {
    +id: UUID
    --
    +firstName: String
    +lastName: String
    +birthDate: DateOnly
    +defaultAddressId: UUID?
  }

  class CustomerArticle {
    +id: UUID
    +articleId: UUID
    --
    +customerId: UUID
    +orderId: UUID?
    +articleName: String?
    +unitPrice: Money?
    +quantity: Integer
  }

  class CustomerOrder {
    +orderId: UUID
    --
    +customerId: UUID
    ..
    +placedAt: DateTime
  }

  CustomerOrder "0..*" -up- "1" Customer : customerId
  Customer "1" -- "0..1" Address : customerId
  CustomerArticle "0..*" -- "1" Customer : customerId
  CustomerArticle "0..*" -right- "0..1" CustomerOrder : orderId
}

package "Sales" {

  class OrderDeliveryInfo {
    +id: UUID
    --
    +orderId: UUID
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }
  class Order {
    +id: UUID
    --
    +customerId: UUID?
    ..
    +placedAt: DateTime
    +type: EOrderType
  }

  class OrderItem {
    +id: UUID
    --
    +orderId: UUID
    ..
    +articleId: UUID
    +articleTitle: String
    +unitPrice: Money
    +quantity: Integer
  }

  note left of Order
    Flow (happy path)
    Customer -> Sales: Place order
    Sales -> Inventory: Request stock reservation
    Inventory -> Sales: StockReserved
    Sales: Initiate/Authorize payment
    Sales: PaymentCaptured
    Sales -> Inventory: Fulfillment request
    Inventory -> Sales: OrderDeliveryInfoFulfilled
  end note

  enum EOrderType {
    Retail
    Ecommerce
  }

  enum EOrderStatusType {
    Processing
    Reserved
    Delivery
    Completed
    Cancelled
  }

  class OrderStatus {
    +id: Integer
    --
    +orderId: UUID
    ..
    +changedAt: DateTime
    +status: EOrderStatusType
    +note: String?
  }

  class Payment {
    +id: UUID
    --
    +orderId: UUID
    ..
    +provider: String
    +referenceId: String
    +amount: Money
    +status: EPaymentStatus
    +createdAt: DateTime
  }

  enum EPaymentStatus {
    Reserved
    Charged
    Failed
    Refunded
  }

  OrderItem "0..*" -- "1" Order : orderId
  OrderStatus "0..*" -- "1" Order : orderId
  OrderDeliveryInfo "1" -- "1" Order : OrderId
  Payment "0..*" -- "1" Order : orderId
}

package "Inventory" {

  enum ReservationStatus {
    Pending
    Ready
    Fulfilled
    Expired
  }

  enum AllocationStatus {
    Pending
    Allocated
    Processed
    Cancelled
  }

  class Warehouse {
    +warehouseId: UUID
    +warehouseCode: String <<unique>>
    --
    +title: String
    +country: String
    +city: String
    +zip: String
    +street: String
    +note: String?
  }

  ' Summary per (warehouseId, articleId).
  ' available = onHandQty - allocatedQty
  class StockUnit {
    +warehouseId: UUID
    +articleId: UUID
    --
    +availableQty: Integer
    +allocatedQty: Integer
  }

  note left of StockUnit
    Summary/read model:
    available = onHandQty - allocatedQty

    Keep onHandQty in sync with StockUnitBatch.initial/remaining
    Keep allocatedQty in sync with active Reservations
    Use optimistic concurrency via version.
  end note

  ' What warehouse workers add when receiving goods
  class StockUnitBatch {
    +stockUnitBatchId: UUID
    --
    +warehouseId: UUID
    +articleId: UUID
    ..
    +supplierRef: String?
    +receivedAt: DateTime
    +initialQty: Integer
    +remainingQty: Integer
    +expiryDate: DateOnly?
    +note: String?
  }

  note left of StockUnitBatch
    remainingQty decreases on picking/dispatch.
    If you later need audit/history,
    reintroduce StockMovement.
  end note

  ' Business promise: reserve quantity for an order line
  class Reservation {
    +orderId: String
    --
    +status: ReservationStatus
    +reservedAt: DateTime
    +note: String?
  }

  ' Physical planning: which batches satisfy the reservation (FIFO/FEFO)
  class ReservationAllocation {
    +orderId: String
    +stockUnitBatchId: UUID
    --
    +quantity: Integer
    +status: AllocationStatus
  }

  ' Relationships
  Warehouse "1" -- "0..*" StockUnit : holds

  ' Conceptual link: batches + reservations roll up into StockUnit
  StockUnit "1" -- "0..*" StockUnitBatch : (warehouseId, articleId)

  Reservation "1" -- "0..*" ReservationAllocation : allocates
  StockUnitBatch "1" -- "0..*" ReservationAllocation : takenFrom
}

' =======================
' RELATIONSHIPS
' =======================

' Identity
SystemUser "1" .. "0..1" Customer

' Customers
CustomerArticle "0..*" .. "1" Article
CustomerOrder "0..1" .. "1" Order

' Inventory
StockUnit "0..1" .. "1" Article
Reservation "1" .. "1" Order
ReservationAllocation "1..*" .. "1" OrderItem
@enduml
