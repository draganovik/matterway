@startuml HLD: Class Diagram - Platform Overview
skinparam classAttributeIconSize 10
hide circle

' =======================
' MODULES
' =======================

package "Identity" {
  enum SystemUserType {
    Customer
    Employee
    Admin
  }

  class SystemUser {
    +id: UUID
    +type: SystemUserType
    +email: String
    +passwordHash: String
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class Session {
    +id: UUID
    +systemUserId: UUID
    +token: String
    +refreshToken: String
    +createdAt: DateTime
    +tokenExpiresAt: DateTime
    +refreshExpiresAt: DateTime
  }
}

package "Catalog" {
  class Discount {
    +id: UUID
    +percentage: Integer
    +validFrom: DateTime
    +validTo: DateTime
  }

  class ProductDiscount {
    +productId: UUID
    +discountId: UUID
  }

  class Product {
    +id: UUID
    +productCode: String
    +title: String
    +description: String
    +regularPriceRsd: Money
    +isAvailable: Boolean
    +addedOn: DateTime
    +updatedOn: DateTime
  }

  class ProductDetail {
    +productId: UUID
    +detailSlug: String
    +value: String
  }

  class Detail {
    +slug: String
    +title: String
  }

  class ProductSpecification {
    +productId: UUID
    +specificationSlug: String
    +value: Decimal
  }

  class Specification {
    +slug: String
    +title: String
    +unit: String
  }

  class ProductImage {
    +id: UUID
    +productId: UUID
    +orderIndex: Integer
    +imageUrl: String
    +imageAlt: String
  }
}

package "Customers" {
  class Address {
    +id: UUID
    +country: String
    +city: String
    +zip: String
    +street: String
    +contactPhone: String
  }

  ' Cart is customer-experience (pre-purchase)
  class CartItem {
    +customerId: UUID
    +productId: UUID
    +quantity: Integer
  }

  class Customer {
    +systemUserId: UUID
    +firstName: String
    +lastName: String
    +email: String
    +phone: String
    +primaryAddressId: UUID
  }
}

package "Sales" {

  class SaleRecordDeliveryInfo {
    +referenceId: String
    +updatedAt: DateTime
    +deliveryCountry: String
    +deliveryCity: String
    +deliveryZip: String
    +deliveryStreet: String
    +deliveryPhone: String
  }
  class SaleRecord {
    +referenceId: String
    +customerId: UUID
    +currency: String
    +totalAmount: Money
    +placedAt: DateTime
    +deliveryAddressId: UUID
    +type: SaleRecordType
  }

  enum SaleRecordType {
    Retail
    Ecommerce
    Wholesale
  }

  class SaleRecordItem {
    +referenceId: String
    +productId: UUID
    +title: String
    +unitPrice: Money
    +quantity: Integer
    +appliedDiscountId: UUID
  }

  enum SaleRecordStatusType {
    Pending
    AwaitingPayment
    PaymentAuthorized
    StockReserved
    Processing
    Delivery
    Completed
    Cancelled
  }

  class SaleRecordStatus {
    +id: Integer
    +referenceId: String
    +changedAt: DateTime
    +status: SaleRecordStatusType
    +description: String
  }
}

package "Inventory" {
  class Warehouse {
    +id: UUID
    +warehouseCode: String
    +title: String
    +description: String
    +country: String
    +city: String
    +zip: String
    +street: String
  }

  class InventoryBatch {
    +inventoryBatchNo: String
    +warehouseId: UUID
    +productId: UUID
    +batchSize: Integer
    +available: Integer
    +registeredAt: DateTime
  }

  ' Reservation bridges Sales<->Inventory
  class StockReservation {
    +id: UUID
    +referenceId: String
    +createdAt: DateTime
    +expiresAt: DateTime
    +status: ReservationStatus
  }

  enum ReservationStatus {
    Requested
    Reserved
    Released
    Failed
  }

  class StockReservationItem {
    +reservationId: UUID
    +productId: UUID
    +quantity: Integer
    +inventoryBatchNo: String
  }
}

package "Finances" {
  class Payment {
    +id: UUID
    +referenceId: String
    +provider: String
    +amount: Money
    +currency: String
    +createdAt: DateTime
  }

  class PaymentStatus {
    +id: Integer
    +paymentId: UUID
    +changedAt: DateTime
    +status: PaymentState
    +note: String
  }

  enum PaymentState {
    Initiated
    Authorized
    Captured
    Failed
    Refunded
  }

  ' Invoicing/Receivables could be added here
}

' =======================
' RELATIONSHIPS
' =======================

' Identity
Session "0..*" --> "1" SystemUser : systemUserId

' Customers
Customer "1" --> "1" SystemUser : systemUserId
Customer "0..1" --> "1" Address : primaryAddressId
CartItem "0..*" --> "1" Customer : customerId
CartItem "0..*" --> "1" Product : productId

' Catalog
ProductDiscount "0..*" --> "1" Product : productId
ProductDiscount "0..*" -up-> "1" Discount : discountId
ProductDetail "0..*" --> "1" Product : productId
ProductDetail "0..*" -up-> "1" Detail : detailSlug
ProductSpecification "0..*" --> "1" Product : productId
ProductSpecification "0..*" -up-> "1" Specification : specificationSlug
ProductImage "0..*" --> "1" Product : productId

' Sales
SaleRecord "0..*" --> "1" Customer : customerId
SaleRecordItem "0..*" --> "1" SaleRecord : orderId
SaleRecordItem "0..*" --> "1" Product : productId
SaleRecordStatus "0..*" --> "1" SaleRecord : orderId
SaleRecordDeliveryInfo "1" --> "1" SaleRecord : saleRecordId

' Inventory
InventoryBatch "0..*" --> "1" Warehouse : warehouseId
InventoryBatch "0..*" -up-> "1" Product : productId
StockReservation "0..*" -up-> "1" SaleRecord : orderId
StockReservationItem "0..*" -up-> "1" StockReservation : reservationId
StockReservationItem "0..*" --> "0..1" InventoryBatch : inventoryBatchNo

' Finances
Payment "0..*" --> "1" SaleRecord : orderId
PaymentStatus "0..*" --> "1" Payment : paymentId

' =======================
' CROSS-BOUNDARY NOTES (events/flows)
' =======================

note "Flow (happy path):\n1) Customer -> Sales: Place order\n2) Sales -> Inventory: Request stock reservation\n3) Inventory -> Sales: StockReserved\n4) Sales -> Finances: Initiate/Authorize payment\n5) Finances -> Sales: PaymentCaptured\n6) Sales -> Inventory: Fulfillment request\n7) Inventory -> Sales: SaleRecordDeliveryInfoFulfilled" as N1
N1 .r. SaleRecord

@enduml