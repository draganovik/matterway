@startuml HLD: Class Diagram - Platform Overview
skinparam classAttributeIconSize 10
hide circle

' =======================
' MODULES
' =======================

package "Identity" {
  enum EIdentityRole {
    Admin
    Manager
    Customer
  }

  class SystemUser {
    +id: UUID
    +email: String
    +userName: String
    +passwordHash: String
    +securityStamp: String
    +created: DateTime
  }

  class IdentityRole {
    +id: UUID
    +name: String
    +normalizedName: String
  }

  class IdentityUserRole {
    +userId: UUID
    +roleId: UUID
  }

  class IdentityUserClaim {
    +id: Integer
    +userId: UUID
    +type: String
    +value: String
  }
}

package "Catalog" {
  class Discount {
    +code: String
    +productId: UUID
    +currency: ESupportedCurrency
    +percentage: Decimal
    +validFrom: DateTime
    +validTo: DateTime?
  }

  class Price {
    +productId: UUID
    +currency: ESupportedCurrency
    +amount: Decimal
  }

  enum ESupportedCurrency {
    RSD
    EUR
  }

  class Product {
    +id: UUID
    +productCode: String
    +title: String
    +description: String
    +isAvailable: Boolean
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class ProductDetail {
    +productId: UUID
    +detailSlug: String
    +value: String
  }

  class Detail {
    +slug: String
    +title: String
  }

  class AttributeSlug {
    +slug: String
  }

  note top of AttributeSlug
  Shared, unique slug namespace
  for Detail & Specification
  (lowercase normalized)
  end note

  class ProductSpecification {
    +productId: UUID
    +specificationSlug: String
    +value: Decimal
  }

  class Specification {
    +slug: String
    +title: String
    +unit: String?
  }

  class ProductImage {
    +id: UUID
    +productId: UUID
    +orderIndex: Integer
    +imageUrl: String
    +imageAlt: String?
  }
}

package "Customers" {
  class Address {
    +id: UUID
    +customerId: UUID
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }

  class Customer {
    +Suid: UUID
    +firstName: String
    +lastName: String
    +email: String
    +phone: String
    +defaultAddressId: UUID
  }

  class CartItem {
    +customerId: UUID
    +productId: UUID
    +quantity: Integer
  }

}

package "Sales" {

  class OrderDeliveryInfo {
    +referenceId: String
    +updatedAt: DateTime
    +deliveryCountry: String
    +deliveryCity: String
    +deliveryZip: String
    +deliveryStreet: String
    +deliveryPhone: String
  }
  class Order {
    +referenceId: String
    +customerId: UUID
    +currency: String
    +totalAmount: Money
    +placedAt: DateTime
    +deliveryAddressId: UUID
    +type: OrderType
  }

  note right of Order
    Flow (happy path)
    Customer -> Sales: Place order
    Sales -> Inventory: Request stock reservation
    Inventory -> Sales: StockReserved
    Sales: Initiate/Authorize payment
    Sales: PaymentCaptured
    Sales -> Inventory: Fulfillment request
    Inventory -> Sales: OrderDeliveryInfoFulfilled
  end note

  enum OrderType {
    Retail
    Ecommerce
  }

  class OrderItem {
    +referenceId: String
    +productId: UUID
    +title: String
    +unitPrice: Money
    +quantity: Integer
    +appliedDiscountId: UUID
  }

  enum OrderStatusType {
    Pending
    AwaitingPayment
    PaymentAuthorized
    StockReserved
    Processing
    Delivery
    Completed
    Cancelled
  }

  class OrderStatus {
    +id: Integer
    +referenceId: String
    +changedAt: DateTime
    +status: OrderStatusType
    +description: String
  }

  class Payment {
    +id: UUID
    +referenceId: String
    +provider: String
    +amount: Money
    +currency: String
    +createdAt: DateTime
  }

  class PaymentStatus {
    +id: Integer
    +paymentId: UUID
    +changedAt: DateTime
    +status: PaymentState
    +note: String
  }

  enum PaymentState {
    Initiated
    Authorized
    Captured
    Failed
    Refunded
  }
}

package "Inventory" {
  class Warehouse {
    +id: UUID
    +warehouseCode: String
    +title: String
    +description: String
    +country: String
    +city: String
    +zip: String
    +street: String
  }

  class ArticleStock {
    +articleStockId: UUID
    +warehouseId: UUID
    +productId: UUID
    +batchSize: Integer
    +available: Integer
    +registeredAt: DateTime
  }

  enum ReservationStatus {
    Requested
    Reserved
    Released
    Failed
  }

  class ArticleStockReservation {
    +articleStockId: UUID
    +orderId: UUID
    +quantity: Integer
    +createdAt: DateTime
    +expiresAt: DateTime
  }
}

' =======================
' RELATIONSHIPS
' =======================

' Identity
SystemUser "0..*" -- "1" Customer : id
SystemUser "1" -- "0..*" IdentityUserClaim
SystemUser "1" -- "0..*" IdentityUserRole
IdentityUserRole "0..*" -- "1" IdentityRole

' Customers
Customer "0..1" -d- "1" Address : defaultAddressId
CartItem "0..*" -u- "1" Customer : customerId
CartItem "0..*" -- "1" Product : productId

' Catalog
Price "1..*" -- "1" Product : productId
Discount "0..*" -- "1" Price : (productId, currency)
ProductDetail "0..*" -- "1" Product : productId
ProductDetail "0..*" -- "1" Detail : detailSlug
ProductSpecification "0..*" -- "1" Product : productId
ProductSpecification "0..*" -- "1" Specification : specificationSlug
ProductImage "0..*" -- "1" Product : productId
Detail -- AttributeSlug : slug (PK/FK)
Specification -- AttributeSlug : slug (PK/FK)

' Sales
Order "0..*" -- "1" Customer : customerId
OrderItem "0..*" -- "1" Order : orderId
OrderItem "0..*" -- "1" Product : productId
OrderStatus "0..*" -- "1" Order : orderId
OrderDeliveryInfo "1" -- "1" Order : OrderId
Payment "0..*" -- "1" Order : orderId
PaymentStatus "0..*" -- "1" Payment : paymentId

' Inventory
ArticleStock "0..*" -- "1" Warehouse : warehouseId
ArticleStock "0..*" -- "1" Product : productId
ArticleStockReservation "0..*" -- "1" ArticleStock : articleStockId
ArticleStockReservation "0..*" -right- "1" Order : orderId
@enduml
