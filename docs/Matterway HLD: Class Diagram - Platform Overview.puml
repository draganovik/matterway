@startuml HLD: Class Diagram - Platform Overview
skinparam classAttributeIconSize 10
hide circle

' =======================
' MODULES
' =======================

package "Identity" {
  enum EIdentityRole {
    Customer
    Employee
  }

  class SystemUser {
    +suid: UUID
    --
    +email: String
    +userName: String
    +passwordHash: String
    +securityStamp: String
    +created: DateTime
  }

  class IdentityRole {
    +id: UUID
    --
    +name: EIdentityRole
  }

  class IdentityUserRole {
    +suid: UUID
    +roleId: UUID
  }

  class IdentityUserClaim {
    +id: Integer
    --
    +suid: UUID
    ..
    +type: String
    +value: String
  }

  SystemUser "1" -- "0..*" IdentityUserClaim
  SystemUser "1" -- "0..*" IdentityUserRole
  IdentityUserRole "0..*" -- "1" IdentityRole
}

package "Catalog" {
  class Discount {
    +code: String
    --
    +articleId: UUID
    ..
    +percentage: Decimal
    +validFrom: DateTime
    +validTo: DateTime?
  }

  class Article {
    +articleId: UUID
    --
    +articleCode: String
    +title: String
    +description: String
    +isAvailable: Boolean
    +priceRSD: Money
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class ArticleDetail {
    +articleId: UUID
    +detailSlug: String
    --
    +value: String
  }

  class Detail {
    +slug: String
    --
    +title: String
  }

  class AttributeSlug {
    +slug: String
  }

  note top of AttributeSlug
  Shared, unique slug namespace
  for Detail & Specification
  (lowercase normalized)
  end note

  class ArticleSpecification {
    +articleId: UUID
    +specificationSlug: String
    --
    +value: Decimal
  }

  class Specification {
    +slug: String
    --
    +title: String
    +unit: String?
  }

  class ArticleImage {
    +id: UUID
    --
    +articleId: UUID
    ..
    +orderIndex: Integer
    +imageUrl: String
    +imageAlt: String?
  }

  Discount "0..*" -- "1" Article : articleId
  ArticleDetail "0..*" -up- "1" Article : articleId
  ArticleDetail "0..*" -up- "1" Detail : detailSlug
  ArticleSpecification "0..*" -- "1" Article : articleId
  ArticleSpecification "0..*" -- "1" Specification : specificationSlug
  ArticleImage "0..*" -- "1" Article : articleId
  Detail -- AttributeSlug : slug (PK/FK)
  Specification -- AttributeSlug : slug (PK/FK)
}

package "Customers" {
  class Address {
    +addressId: UUID
    --
    +suid: UUID
    ..
    +country: String
    +city: String
    +zipCode: String
    +addressLine1: String
    +addressLine2: String
    +contactPhone: String
  }

  class Customer {
    +suid: UUID
    --
    +firstName: String
    +lastName: String
    +email: String
    +phone: String
    +defaultAddressId: UUID
  }

  class CartItem {
    +suid: UUID
    +articleId: UUID
    --
    +quantity: Integer
  }

  class PlacedOrder {
    +orderId: String
    --
    +suid: UUID
    ..
    +placedAt: DateTime
  }

  PlacedOrder "0..*" -- "1" Customer : suid
  Customer "1" -- "0..1" Address : defaultAddressId
  CartItem "0..*" -- "1" Customer : suid
}

package "Sales" {

  class OrderDeliveryInfo {
    +id: UUID
    --
    +orderId: String
    ..
    +deliveryCountry: String
    +deliveryCity: String
    +deliveryZip: String
    +deliveryStreet: String
    +deliveryPhone: String
  }
  class Order {
    +orderId: String
    --
    +referenceId: String
    ..
    +currency: String
    +totalAmount: Money
    +placedAt: DateTime
    +deliveryAddressId: UUID
    +type: OrderType
  }

  note right of Order
    Flow (happy path)
    Customer -> Sales: Place order
    Sales -> Inventory: Request stock reservation
    Inventory -> Sales: StockReserved
    Sales: Initiate/Authorize payment
    Sales: PaymentCaptured
    Sales -> Inventory: Fulfillment request
    Inventory -> Sales: OrderDeliveryInfoFulfilled
  end note

  enum OrderType {
    Retail
    Ecommerce
  }

  enum OrderStatusType {
    Pending
    AwaitingPayment
    PaymentAuthorized
    StockReserved
    Processing
    Delivery
    Completed
    Cancelled
  }

  class OrderStatus {
    +id: Integer
    --
    +orderId: String
    ..
    +changedAt: DateTime
    +status: OrderStatusType
    +note: String
  }

  class Payment {
    +paymentId: UUID
    --
    +orderId: String
    ..
    +provider: String
    +amount: Money
    +currencyCode: String
    +createdAt: DateTime
  }

  class PaymentStatus {
    +id: Integer
    --
    +paymentId: UUID
    ..
    +changedAt: DateTime
    +status: PaymentState
    +note: String
  }

  enum PaymentState {
    Initiated
    Authorized
    Captured
    Failed
    Refunded
  }

  OrderStatus "0..*" -- "1" Order : orderId
  OrderDeliveryInfo "1" -- "1" Order : OrderId
  Payment "0..*" -- "1" Order : orderId
  PaymentStatus "0..*" -- "1" Payment : paymentId
}

package "Inventory" {

  enum ReservationStatus {
    Pending
    Ready
    Fulfilled
    Expired
  }

  enum AllocationStatus {
    Pending
    Allocated
    Processed
    Cancelled
  }

  class Warehouse {
    +warehouseId: UUID
    +warehouseCode: String <<unique>>
    --
    +title: String
    +country: String
    +city: String
    +zip: String
    +street: String
    +note: String?
  }

  ' Summary per (warehouseId, articleId).
  ' available = onHandQty - allocatedQty
  class StockUnit {
    +warehouseId: UUID
    +articleId: UUID
    --
    +availableQty: Integer
    +allocatedQty: Integer
  }

  note right of StockUnit
    Summary/read model:
    available = onHandQty - allocatedQty

    Keep onHandQty in sync with StockUnitBatch.initial/remaining
    Keep allocatedQty in sync with active Reservations
    Use optimistic concurrency via version.
  end note

  ' What warehouse workers add when receiving goods
  class StockUnitBatch {
    +stockUnitBatchId: UUID
    --
    +warehouseId: UUID
    +articleId: UUID
    ..
    +supplierRef: String?
    +receivedAt: DateTime
    +initialQty: Integer
    +remainingQty: Integer
    +expiryDate: DateOnly?
    +note: String?
  }

  note bottom of StockUnitBatch
    remainingQty decreases on picking/dispatch.
    If you later need audit/history, reintroduce StockMovement.
  end note

  ' Business promise: reserve quantity for an order line
  class Reservation {
    +orderId: String
    --
    +status: ReservationStatus
    +reservedAt: DateTime
    +note: String?
  }

  ' Physical planning: which batches satisfy the reservation (FIFO/FEFO)
  class ReservationAllocation {
    +orderId: String
    +stockUnitBatchId: UUID
    --
    +quantity: Integer
    +status: AllocationStatus
  }

  ' Relationships
  Warehouse "1" -- "0..*" StockUnit : holds

  ' Conceptual link: batches + reservations roll up into StockUnit
  StockUnit "1" -- "0..*" StockUnitBatch : (warehouseId, articleId)

  Reservation "1" -- "0..*" ReservationAllocation : allocates
  StockUnitBatch "1" -- "0..*" ReservationAllocation : takenFrom
}

' =======================
' RELATIONSHIPS
' =======================

' Identity
SystemUser "1" .. "0..1" Customer : suid

' Customers
CartItem "0..*" .up. "1" Article : articleId
PlacedOrder .up. Order : orderId

' Inventory
StockUnit "0..*" .. "1" Article : articleId
Reservation "1..*" .. "1" Order : orderId
@enduml
